{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "1. Installation complète (environnement + bibliothèques + .env)",
            "type": "shell",
            "command": "powershell -ExecutionPolicy Bypass -File scripts/setup_windows.ps1",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "shared" }
        },
        {
            "label": "2. Lancer l'application",
            "type": "shell",
            "command": "& '${workspaceFolder}/.venv/Scripts/python.exe' main.py",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated" }
        },
        {
            "label": "3. Lancer les tests",
            "type": "shell",
            "command": "& '${workspaceFolder}/.venv/Scripts/python.exe' -m unittest discover -s tests -t . -v",
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "shared" }
        },
        {
            "label": "4. Créer l'exécutable Windows (.exe)",
            "type": "shell",
            "command": "cmd /c build_exe.bat",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated" }
        },
        {
            "label": "5. Mettre à jour les bibliothèques",
            "type": "shell",
            "command": "& '${workspaceFolder}/.venv/Scripts/python.exe' -m pip install -r requirements.txt",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "shared" }
        }
    ]
}
